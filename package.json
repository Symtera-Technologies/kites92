{
  "name": "kites92",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "db:push": "prisma db push",
    "db:sql": "prisma migrate diff --from-empty --to-schema-datamodel prisma/schema.prisma --script > prisma/schema.sql",
    "db:seed": "node --env-file=.env prisma/seed.mjs",
    "db:studio": "prisma studio",
    "test:sim": "node scripts/check-kite-sim.mjs",
    "test:ik": "node scripts/check-ik.mjs",
    "test": "npm run test:sim && npm run test:ik && npm run test:commerce",
    "test:commerce": "node scripts/check-commerce.mjs"
  },
  "dependencies": {
    "@prisma/client": "^6.16.0",
    "@react-three/drei": "^10.7.0",
    "@react-three/fiber": "^9.3.0",
    "bcryptjs": "^3.0.2",
    "clsx": "^2.1.1",
    "gsap": "^3.13.0",
    "jose": "^6.1.0",
    "lenis": "^1.3.1",
    "next": "^15.5.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "server-only": "^0.0.1",
    "tailwind-merge": "^3.3.0",
    "three": "^0.180.0",
    "zod": "^3.25.0",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@types/three": "^0.180.0",
    "autoprefixer": "^10.4.21",
    "eslint": "^9.0.0",
    "eslint-config-next": "^15.5.0",
    "postcss": "^8.5.0",
    "prisma": "^6.16.0",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.9.0"
  }
}
