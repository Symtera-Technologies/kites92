# ─── Database (cPanel MySQL) ───────────────────────────────────────────────
# In cPanel: MySQL Databases -> create DB + user -> grant ALL.
# cPanel prefixes both names with your account, e.g. kites92_shop / kites92_app.
#
# Paste the password EXACTLY as cPanel gave it to you — no percent-encoding, no
# escaping, no quoting of punctuation. src/lib/db-url.mjs encodes the
# credentials when it assembles the connection URL.
#
# That is the whole point of splitting these out. In a hand-written connection
# string, / # and ? end the authority and make the URL unparseable or point it
# at the wrong host, and % quietly corrupts the password because the URL is
# percent-decoded before it reaches the server. All four turn up in generated
# passwords, and all four fail at the end of a deploy as an authentication
# error that looks like something else.
DB_HOST="localhost"
DB_PORT="3306"
DB_NAME="DBNAME"
DB_USER="USER"
DB_PASSWORD=""

# Shared hosts cap concurrent MySQL connections hard, and Prisma's default pool
# is larger than a typical cPanel allowance — exhausting it throws
# "Too many connections" under even light traffic. Leave this empty only on a
# dedicated server, where the bigger default pool is the right answer.
DB_CONNECTION_LIMIT="5"

# Only if MySQL listens on a unix socket rather than TCP. On shared Linux hosts
# this is the difference between "the database works in phpMyAdmin" and "the app
# cannot reach the database": the mysql CLI and phpMyAdmin reach localhost over
# the socket, while the app opens a TCP connection. The symptom is
# "Can't reach database server at `localhost:3306`" while everything in cPanel
# looks healthy. Usually /var/lib/mysql/mysql.sock — run `npm run diagnose:db`
# on the server and it will tell you the path it found.
DB_SOCKET=""

# Only if your host hands you a ready-made connection string (PlanetScale,
# Railway, a VPS behind a connection proxy). When set it overrides every DB_*
# value above and is passed through untouched, parameters and all. MYSQL_URL and
# DB_URL are accepted too.
#
# It is NOT required to run the app. src/lib/db.ts passes the composed URL
# straight to PrismaClient, so the application never reads this variable. It is
# needed only by the Prisma CLI (db:push, db:seed, db:studio, and the
# prisma generate inside npm run build), and scripts/with-database-url.mjs
# composes and injects it for those automatically.
# DATABASE_URL=""

# If your platform injects its own database variables, you do not need to rename
# anything: MYSQLHOST / MYSQL_HOST / DATABASE_HOST, MYSQLDATABASE /
# MYSQL_DATABASE / DB_DATABASE, MYSQLUSER / MYSQL_USER, MYSQLPASSWORD /
# MYSQL_PASSWORD / DB_PASS, MYSQLPORT / MYSQL_PORT and MYSQL_UNIX_PORT are all
# read as fallbacks. The DB_* names above win where both are present.
# `npm run diagnose:db` prints which name each part was taken from.

# ─── Site ─────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL="https://kites92.com"
NEXT_PUBLIC_SITE_NAME="Kites92"

# ─── Auth ─────────────────────────────────────────────────────────────────
# REQUIRED. Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# Changing this invalidates every signed-in session.
AUTH_SECRET=""

# ─── Storefront contact ───────────────────────────────────────────────────
# International format, digits only — used to build wa.me links.
NEXT_PUBLIC_WHATSAPP_NUMBER="923001234567"

# ─── Images ───────────────────────────────────────────────────────────────
# Set to 1 on shared cPanel hosting, where `sharp` often has no prebuilt binary.
NEXT_IMAGE_UNOPTIMIZED="0"

# Where product photographs uploaded through the admin are written. Defaults to
# ./uploads beside the app. Deliberately outside public/ — that folder is part
# of the build and a redeploy would wipe it. Must be writable by the Node
# process, and must be in your backup set.
UPLOAD_DIR=""

# ─── Seed ─────────────────────────────────────────────────────────────────
# Admin account created by `npm run db:seed`. Change the password immediately.
SEED_ADMIN_EMAIL="owner@kites92.com"
SEED_ADMIN_PASSWORD=""
